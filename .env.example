# AdMob App IDs (AdMob console → Apps → your app → App settings).
# Required for production release APK/AAB so manifest matches your production ad units.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-2580301275844431~xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-2580301275844431~xxxxxxxxxx
# Optional: force production ad unit IDs while debugging in dev client
# EXPO_PUBLIC_ADMOB_PRODUCTION_ADS=true

# Emulator: skip JS ad init only (native SDK still linked). See docs/android-emulator-admob.md
# EXPO_PUBLIC_SKIP_ADMOB_ON_EMULATOR=true

# Build-time only: omit native AdMob from APK (scripts/build-android-release-no-ads.ps1)
# EXPO_PUBLIC_DISABLE_NATIVE_ADMOB=true
